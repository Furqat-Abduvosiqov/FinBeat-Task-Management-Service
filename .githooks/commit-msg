#!/bin/sh
#
# Rejects commit messages that attribute authorship to an AI assistant.
#
# Every commit in this repository is authored by a human and must read that way in the history.
# Assistant-generated trailers ("Co-Authored-By: Claude", "Generated with ...", session links,
# noreply@anthropic.com and friends) are not accepted.
#
# Enabled for this clone with:
#     git config core.hooksPath .githooks
#
# That is a per-clone setting, so it must be run once after cloning. See CONTRIBUTING.md.
# Bypassing it with `git commit --no-verify` defeats the point; don't.

msg_file=$1
[ -f "$msg_file" ] || exit 0

# Strip comment lines (git's own template) before matching, so the hook never trips on them.
body=$(grep -v '^#' "$msg_file")

matched=$(printf '%s\n' "$body" | grep -n -i -E \
    -e 'co-authored-by:[[:space:]]*(claude|anthropic|copilot|chatgpt|gpt-|gemini|cursor|codex)' \
    -e 'noreply@anthropic\.com' \
    -e 'users\.noreply\.github\.com>[[:space:]]*$.*copilot' \
    -e '^[[:space:]]*claude-session:' \
    -e 'generated[[:space:]]+with[[:space:]]+\[?(claude|chatgpt|copilot|cursor|gemini)' \
    -e 'ai[[:space:]]*-?[[:space:]]*(generated|assisted)[[:space:]]+(commit|by)' \
    -e '🤖[[:space:]]*generated')

if [ -n "$matched" ]; then
    printf '\n' >&2
    printf 'commit-msg hook: AI authorship attribution is not allowed in commit messages.\n' >&2
    printf '\n' >&2
    printf 'Offending line(s):\n' >&2
    printf '%s\n' "$matched" | sed 's/^/    /' >&2
    printf '\n' >&2
    printf 'Remove the trailer and commit again. Commits here are authored by a human and the\n' >&2
    printf 'history must say so. See CONTRIBUTING.md.\n' >&2
    printf '\n' >&2
    exit 1
fi

exit 0
