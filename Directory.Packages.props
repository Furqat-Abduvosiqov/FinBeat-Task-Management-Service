<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- API -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.31" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- Listener -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />

    <!-- Application: DbSet on IApplicationDbContext. The provider belongs to Infrastructure. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />

    <!-- Test projects -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />

    <!--
      Shouldly for every test project, unit and architecture alike. FluentAssertions was the
      obvious alternative and is more widely recognised, but 8.0.0 moved to the Xceed commercial
      licence, which is paid for non-open-source use; staying on the last Apache-2.0 release
      (7.2.2) means a dependency frozen since early 2025. Shouldly is MIT and current, so the
      question never arises. It also reports the failing expression itself rather than only the
      values, which reads better in a test report.
    -->
    <PackageVersion Include="Shouldly" Version="4.2.1" />

    <!-- FakeTimeProvider. The domain takes time as a parameter, so tests assert exact instants. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <!--
      The eNhancedEdition fork, not NetArchTest.Rules. The original's last release is 1.3.2 from
      2021-05-23 and it is effectively unmaintained; this fork (MIT, built on 1.3.2) is current and
      carries a newer Mono.Cecil. Same fluent API and same NetArchTest.Rules namespace.
    -->
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />

    <!--
      Infrastructure: the PostgreSQL provider, the snake_case rewriter, and the migration
      scaffolder. Infrastructure is deliberately absent from
      ArchitectureModel.AllowedExternalReferences, so this is the layer where a provider belongs.
    -->
    <!--
      Named explicitly only to unify the graph upward. The Npgsql provider 8.0.11 asks for Relational
      8.0.11 while the Design package asks for 8.0.31, and Design is PrivateAssets="all" so it cannot
      settle the difference for anything downstream. Without this the Api resolves the lower one and
      the build warns (MSB3277).
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.31" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageVersion Include="EFCore.NamingConventions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31" />
    <!-- IConfiguration for AddInfrastructure. EF Core does not bring it transitively. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />

    <!-- Integration tests: a throwaway PostgreSQL, and configuration to drive AddInfrastructure. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
  </ItemGroup>

</Project>
