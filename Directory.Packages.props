<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- API -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.31" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- Listener -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />

    <!-- Test projects -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />

    <!--
      Shouldly for every test project, unit and architecture alike. FluentAssertions was the
      obvious alternative and is more widely recognised, but 8.0.0 moved to the Xceed commercial
      licence, which is paid for non-open-source use; staying on the last Apache-2.0 release
      (7.2.2) means a dependency frozen since early 2025. Shouldly is MIT and current, so the
      question never arises. It also reports the failing expression itself rather than only the
      values, which reads better in a test report.
    -->
    <PackageVersion Include="Shouldly" Version="4.2.1" />

    <!-- FakeTimeProvider. The domain takes time as a parameter, so tests assert exact instants. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <!--
      The eNhancedEdition fork, not NetArchTest.Rules. The original's last release is 1.3.2 from
      2021-05-23 and it is effectively unmaintained; this fork (MIT, built on 1.3.2) is current and
      carries a newer Mono.Cecil. Same fluent API and same NetArchTest.Rules namespace.
    -->
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
  </ItemGroup>

</Project>
