<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      The 0-warning rule, enforced rather than merely asserted in prose. Without this a missing XML
      <summary> is CS1591 at warning severity and nothing stops it reaching dev.

      NuGet audit advisories stay warnings on purpose: a CVE newly disclosed against an already
      pinned package would otherwise turn a green build red with no code change, which is news to
      act on rather than a reason to block the build.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    The exceptions for tests/, kept here rather than in a Directory.Build.props of their own. MSBuild
    imports only the nearest such file and stops, so a second one would have to re-import this one by
    hand to avoid silently dropping TargetFramework and the rest - one more moving part than a
    condition.

    GenerateDocumentationFile off: with the warnings-as-errors rule above, every public test class and
    every [Fact] would be CS1591, and their names already are the sentence a summary would repeat.
    IsPackable off: a test project is not a library anyone installs.
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)tests'))">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
