<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Technology lives here, which is why the architecture rules leave this layer unconstrained:
        ArchitectureModel.AllowedExternalReferences has no entry for Infrastructure.
    -->
    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="EFCore.NamingConventions" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <!-- IConfiguration for AddInfrastructure. EF Core does not bring it transitively. -->
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
        <!-- The options pattern: binding, data-annotation validation, and validation at host start. -->
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
        <!--
            Messaging. The transactional outbox is why MassTransit.EntityFrameworkCore sits here rather
            than in a host: its tables live on ApplicationDbContext, so a publish and the state change
            that caused it commit together or not at all.
        -->
        <PackageReference Include="MassTransit" />
        <PackageReference Include="MassTransit.RabbitMQ" />
        <PackageReference Include="MassTransit.EntityFrameworkCore" />
        <!--
            Design-time only: the migration scaffolder and the dotnet-ef tool load it. PrivateAssets
            keeps it out of anything that references this project.
        -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
        Domain named explicitly even though Application already brings it: the persistence model binds
        directly to TaskItem and its value objects, and that should not depend on Application keeping
        its own reference. ProjectReferenceTests allows it.
    -->
    <ItemGroup>
        <ProjectReference Include="..\FinBeat.TaskManagement.Application\FinBeat.TaskManagement.Application.csproj" />
        <ProjectReference Include="..\FinBeat.TaskManagement.Domain\FinBeat.TaskManagement.Domain.csproj" />
    </ItemGroup>

</Project>
