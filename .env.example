# Copy to .env only when a default does not suit. docker-compose.yml carries the same values
# inline, so the stack runs without this file.
#
# The usual reason to need it: a port below is already bound by a container you started by hand.

# Which host interface the published ports bind to. 0.0.0.0 lets other machines on your network
# reach the stack - there is no authentication and DELETE is a hard delete, so do that deliberately.
# A bare IPv4 address or hostname only; an IPv6 literal needs the long port syntax.
BIND_ADDRESS=127.0.0.1

# Database. The name is also what appsettings.Development.json uses for a non-container run.
POSTGRES_DB=finbeat_taskmanagement
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Broker. 15672 is the management UI, where the unroutable queue is worth a look.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Tracing. 4317 is OTLP over gRPC, which is what the exporter defaults to.
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Logging. Development on its own would mean Debug; this keeps Swagger without the firehose.
LOG_LEVEL=Information

# The API. Development serves Swagger at /swagger; set Production to turn it off.
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
